        192,
        32
      ]
    },
    {
      "parameters": {
        "maxItems": 10
      },
      "id": "2f8c6099-0fdf-40e4-bcb3-1d31480076b1",
      "name": "Limit",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        416,
        32
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "90533aee-9782-48d3-8691-d060c9082511",
      "name": "Aggregate",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        640,
        32
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI news editor. Turn the news JSON below into a clean HTML email.\n\nRULES:\n- Pick the 5 most important, distinct stories. Use only facts from the JSON.\n- Per story: a short headline, a 2-sentence summary, a 1-sentence Key Takeaway, and the story URL from the JSON.\n- Simple English. Never invent facts or links.\n\nOUTPUT: Raw HTML only. Start directly with <div. Never write ```html or any code fence, markdown, or text outside the HTML.\n\nTEMPLATE:\n<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:700px;margin:auto;padding:24px;color:#222;\">\n\n<h1 style=\"text-align:center;font-size:38px;font-weight:bold;margin:0 0 12px;\">Today's Top 5 AI News</h1>\n<p style=\"text-align:center;font-size:15px;color:#333;margin:0 0 40px;\">A curated summary of the most significant developments in Artificial Intelligence.</p>\n\n<h2 style=\"font-size:26px;font-weight:bold;margin:32px 0 12px;\">1. [Headline]</h2>\n<p style=\"font-size:15px;line-height:1.6;margin:0 0 16px;\">[2-sentence summary]</p>\n<div style=\"background:#f0f6ff;padding:16px 20px;border-radius:6px;font-size:15px;line-height:1.6;margin:0 0 16px;\"><strong><em>Key Takeaway:</em></strong> <em>[1 sentence]</em></div>\n<a href=\"[URL]\" target=\"_blank\" style=\"color:#1a56c8;font-size:15px;font-weight:bold;text-decoration:none;\">Read Original Source</a>\n\n[Repeat the same block for stories 2 to 5, numbered continuously]\n\n</div>\n\nNEWS:\n{{ JSON.stringify($json.data) }}",
        "batching": {}
      },
      "id": "6475c861-31cc-41b6-a687-8d75058a8c1b",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        864,
        32
      ]
    },
    {
      "parameters": {
        "sendTo": "your-email@example.com",
        "subject": "Daily AI news update",
        "message": "={{$json.text}}",
        "options": {}
      },
      "id": "7a6d0777-0b36-4813-b890-87d9fa7805ff",
      "name": "Send a message",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1232,
        32
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    }
  ],
